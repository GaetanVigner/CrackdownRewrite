gpu_frame_stats on Vulkan: why render passes end, per frame: pipeline barriers, forced ends for copies and dispatches
(uploads, resolves, transfers), render target changes, occlusion query begins and ends (0053 ends the pass around
each), submission ends, other. Each end stores the attachments and the next pass loads them again, which at 1440p
with host MSAA costs GPU time (~200 render pass entries a frame at the city spot).

diff --git a/include/rex/graphics/vulkan/command_processor.h b/include/rex/graphics/vulkan/command_processor.h
--- a/include/rex/graphics/vulkan/command_processor.h
+++ b/include/rex/graphics/vulkan/command_processor.h
@@ -479,6 +479,22 @@ class VulkanCommandProcessor : public CommandProcessor {
   // (begin after an end or a change) counted too.
   static constexpr uint32_t kDrawSections = 15;
   uint64_t render_passes_begun_ = 0;
+  // gpu_frame_stats: why render passes end (each end stores and later reloads the attachments).
+  enum RenderPassEndReason : uint32_t {
+    kRenderPassEndBarrier,       // pipeline barriers before a copy, dispatch or draw
+    kRenderPassEndForced,        // copies and dispatches outside a pass (uploads, resolves, transfers)
+    kRenderPassEndTarget,        // another render target or transfer pass
+    kRenderPassEndQuery,         // occlusion query begin or end
+    kRenderPassEndSubmission,    // the submission ends
+    kRenderPassEndOther,
+    kRenderPassEndReasonCount,
+  };
+  RenderPassEndReason render_pass_end_reason_ = kRenderPassEndOther;
+  uint64_t render_pass_ends_[kRenderPassEndReasonCount] = {};
+  void EndRenderPassFor(RenderPassEndReason reason) {
+    render_pass_end_reason_ = reason;
+    EndRenderPass();
+  }
   // UpdateBindings subsections (kBindingsSectionNames in the .cpp) and descriptor sets written.
   static constexpr uint32_t kBindingsSections = 5;
   uint64_t bindings_mark_ = 0;
diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
