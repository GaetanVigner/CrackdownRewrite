     return false;
   }
-  EndRenderPass();
+  EndRenderPassFor(force_end_render_pass ? kRenderPassEndForced : kRenderPassEndBarrier);
   for (auto it = pending_barriers_.cbegin(); it != pending_barriers_.cend(); ++it) {
     auto it_next = std::next(it);
     bool is_last = it_next == pending_barriers_.cend();
@@ -3331,6 +3331,7 @@ void VulkanCommandProcessor::SubmitBarriersAndEnterRenderTargetCacheRenderPass(
 
   ++render_passes_begun_;
   if (in_render_pass_) {
+    ++render_pass_ends_[kRenderPassEndTarget];
     if (use_dynamic_rendering) {
       deferred_command_buffer_.CmdVkEndRendering();
     } else {
