+void VulkanCommandProcessor::LogCpuFrameStats() {
+  const auto now = std::chrono::steady_clock::now();
+  const uint64_t processor_ns = ThreadCpuTimeNs();
+  const uint64_t submission_ns = async_submission_cpu_ns_.load(std::memory_order_relaxed);
+  if (!cpu_stats_frames_++) {
+    cpu_stats_start_ = now;
+    cpu_stats_processor_ns_ = processor_ns;
+    cpu_stats_submission_ns_ = submission_ns;
+    return;
+  }
+  const double seconds = std::chrono::duration<double>(now - cpu_stats_start_).count();
+  if (seconds < 10.0) {
+    return;
+  }
+  const double frames = double(cpu_stats_frames_ - 1);
+  const double per_frame_ms = 1.0e-6 / frames;
+  REXGPU_INFO(
+      "Vulkan CPU per frame over {:.1f} s: frame {:.2f} ms, command processor thread {:.2f} ms, "
+      "submission thread {:.2f} ms (async submission {})",
+      seconds, seconds * 1000.0 / frames, double(processor_ns - cpu_stats_processor_ns_) * per_frame_ms,
+      double(submission_ns - cpu_stats_submission_ns_) * per_frame_ms,
+      async_submission_enabled_ ? "on" : "off");
+  cpu_stats_frames_ = 1;
+  cpu_stats_start_ = now;
+  cpu_stats_processor_ns_ = processor_ns;
+  cpu_stats_submission_ns_ = submission_ns;
+}
