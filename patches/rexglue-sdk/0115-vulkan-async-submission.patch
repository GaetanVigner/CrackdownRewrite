+void VulkanCommandProcessor::StartAsyncSubmission() {
+  if (async_submission_thread_) {
+    return;
+  }
+  async_submission_stop_ = false;
+  async_submission_busy_ = false;
+  async_submission_failed_.store(false, std::memory_order_relaxed);
+  // Everything ended so far was submitted synchronously.
+  async_submission_submitted_.store(GetCurrentSubmission() - 1, std::memory_order_release);
+  async_submission_thread_ = rex::thread::Thread::Create({}, [this]() { AsyncSubmissionThread(); });
+  if (!async_submission_thread_) {
+    REXGPU_WARN("Vulkan: Failed to create the submission thread, submitting synchronously");
+    return;
+  }
+  async_submission_thread_->set_name("Vulkan Submission");
+  async_submission_enabled_ = true;
+}
+
+void VulkanCommandProcessor::StopAsyncSubmission() {
+  if (!async_submission_thread_) {
+    return;
+  }
+  {
+    std::lock_guard<std::mutex> lock(async_submission_mutex_);
+    async_submission_stop_ = true;
+  }
+  async_submission_work_cv_.notify_one();
+  rex::thread::Wait(async_submission_thread_.get(), false);
+  async_submission_thread_.reset();
+  async_submission_enabled_ = false;
+  async_submission_free_buffers_.clear();
+}
+
+void VulkanCommandProcessor::AwaitAsyncSubmissions() {
+  if (!async_submission_enabled_) {
+    return;
+  }
+  std::unique_lock<std::mutex> lock(async_submission_mutex_);
+  async_submission_idle_cv_.wait(
+      lock, [this]() { return async_submission_queue_.empty() && !async_submission_busy_; });
+}
+
+void VulkanCommandProcessor::AsyncSubmissionThread() {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  std::unique_lock<std::mutex> lock(async_submission_mutex_);
+  while (true) {
+    async_submission_work_cv_.wait(
+        lock, [this]() { return async_submission_stop_ || !async_submission_queue_.empty(); });
+    if (async_submission_queue_.empty()) {
+      // Stopping, and everything queued has been submitted.
+      break;
+    }
+    AsyncSubmission job = std::move(async_submission_queue_.front());
+    async_submission_queue_.pop_front();
+    async_submission_busy_ = true;
+    lock.unlock();
+
+    // Jobs run in queue order, so submissions reach the queue in order. After a failure the rest
+    // are dropped: the command processor treats it as a lost device.
+    bool failed = async_submission_failed_.load(std::memory_order_relaxed);
+    if (!failed) {
+      VkCommandBufferBeginInfo command_buffer_begin_info;
+      command_buffer_begin_info.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
+      command_buffer_begin_info.pNext = nullptr;
+      command_buffer_begin_info.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+      command_buffer_begin_info.pInheritanceInfo = nullptr;
+      if (dfn.vkResetCommandPool(device, job.command_buffer.pool, 0) != VK_SUCCESS ||
+          dfn.vkBeginCommandBuffer(job.command_buffer.buffer, &command_buffer_begin_info) !=
+              VK_SUCCESS) {
+        REXGPU_ERROR("Vulkan: Failed to begin a submission's command buffer");
+        failed = true;
+      }
+    }
+    if (!failed) {
+      job.commands->Execute(job.command_buffer.buffer);
+      if (dfn.vkEndCommandBuffer(job.command_buffer.buffer) != VK_SUCCESS) {
+        REXGPU_ERROR("Vulkan: Failed to end a submission's command buffer");
+        failed = true;
+      }
+    }
+    if (!failed) {
+      VkSubmitInfo submit_info;
+      submit_info.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
+      submit_info.pNext = nullptr;
+      submit_info.waitSemaphoreCount = uint32_t(job.wait_semaphores.size());
+      submit_info.pWaitSemaphores = job.wait_semaphores.empty() ? nullptr : job.wait_semaphores.data();
+      submit_info.pWaitDstStageMask =
+          job.wait_stage_masks.empty() ? nullptr : job.wait_stage_masks.data();
+      submit_info.commandBufferCount = 1;
+      submit_info.pCommandBuffers = &job.command_buffer.buffer;
+      submit_info.signalSemaphoreCount = 0;
+      submit_info.pSignalSemaphores = nullptr;
+      VkResult submit_result;
+      {
+        ui::vulkan::VulkanDevice::Queue::Acquisition queue_acquisition =
+            vulkan_device->AcquireQueue(vulkan_device->queue_family_graphics_compute(), 0);
+        submit_result = dfn.vkQueueSubmit(queue_acquisition.queue(), 1, &submit_info, job.fence);
+      }
+      if (submit_result != VK_SUCCESS) {
+        REXGPU_ERROR("Vulkan: Failed to submit a command buffer");
+        failed = true;
+      }
+    }
+    if (failed && !async_submission_failed_.exchange(true, std::memory_order_acq_rel) &&
+        graphics_system_) {
+      graphics_system_->OnHostGpuLossFromAnyThread(true);
+    }
+    async_submission_submitted_.store(job.submission, std::memory_order_release);
+    async_submission_cpu_ns_.store(ThreadCpuTimeNs(), std::memory_order_relaxed);
+    job.commands->Reset();
+
+    lock.lock();
+    async_submission_free_buffers_.push_back(std::move(job.commands));
+    async_submission_busy_ = false;
+    if (async_submission_queue_.empty()) {
+      async_submission_idle_cv_.notify_all();
+    }
+  }
+}
