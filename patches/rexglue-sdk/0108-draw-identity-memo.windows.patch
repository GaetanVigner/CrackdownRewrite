+uint64_t D3D12CommandProcessor::DrawMemoStateHash(uint32_t used_texture_mask) const {
+  // What the memoized outputs are derived from besides the shaders: the render state (but
+  // RB_COPY_* to RB_SAMPLE_COUNT_ADDR, which only matter to resolves and change between passes) and
+  // the fetch constants of the textures the shaders use. Hashed from the register file, so the
+  // check reads no memo state but the hash.
+  constexpr uint32_t kCopyFirst = XE_GPU_REG_RB_COPY_CONTROL - kDrawMemoRenderStateFirst;
+  constexpr uint32_t kCopyEnd = XE_GPU_REG_RB_SAMPLE_COUNT_ADDR + 1 - kDrawMemoRenderStateFirst;
+  const uint32_t* values = register_file_->values;
+  const uint32_t* render_state = values + kDrawMemoRenderStateFirst;
+  uint64_t hash = XXH3_64bits(render_state, kCopyFirst * sizeof(uint32_t));
+  hash = XXH3_64bits_withSeed(render_state + kCopyEnd,
+                              (kDrawMemoRenderStateCount - kCopyEnd) * sizeof(uint32_t), hash);
+  uint32_t textures_remaining = used_texture_mask;
+  uint32_t index;
+  while (rex::bit_scan_forward(textures_remaining, &index)) {
+    textures_remaining &= ~(uint32_t(1) << index);
+    hash = XXH3_64bits_withSeed(values + XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 + index * 6,
+                                6 * sizeof(uint32_t), hash);
+  }
+  return hash;
+}
+
+std::unique_ptr<CommandProcessor::DrawMemo> D3D12CommandProcessor::CreateDrawMemo() {
+  if (!REXCVAR_GET(gpu_draw_identity_memo)) {
+    return nullptr;
+  }
+  return std::make_unique<D3D12DrawMemo>();
+}
