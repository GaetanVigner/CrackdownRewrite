+                              memory_->TranslatePhysical<uint32_t*>(operation.b), operation.c);
+        } else {
+          const uint32_t* microcode = words + operation.b;
+          shader = LoadShader(shader_type, uint32_t(uintptr_t(microcode)), microcode, operation.c);
+        }
+        if (shader_type == xenos::ShaderType::kVertex) {
+          active_vertex_shader_ = shader;
+        } else {
+          active_pixel_shader_ = shader;
+        }
+      } break;
+      case Op::kDraw:
+        ExecuteDraw(operation.a,
+                    ((operation.a >> 8) & 0x7F) == PM4_DRAW_INDX ? "PM4_DRAW_INDX"
+                                                                 : "PM4_DRAW_INDX_2",
+                    operation.b, operation.c, operation.d);
+        break;
+      case Op::kIndirectBuffer:
+        ExecuteIndirectBuffer(operation.a, operation.b);
+        break;
+      case Op::kBinMaskLo:
+        bin_mask_ = (bin_mask_ & 0xFFFFFFFF00000000ull) | operation.a;
+        break;
+      case Op::kBinMaskHi:
+        bin_mask_ = (bin_mask_ & 0xFFFFFFFFull) | (uint64_t(operation.a) << 32);
+        break;
+      case Op::kBinSelectLo:
+        bin_select_ = (bin_select_ & 0xFFFFFFFF00000000ull) | operation.a;
+        break;
+      case Op::kBinSelectHi:
+        bin_select_ = (bin_select_ & 0xFFFFFFFFull) | (uint64_t(operation.a) << 32);
+        break;
+      case Op::kBinMask:
+        bin_mask_ = (uint64_t(operation.a) << 32) | operation.b;
+        break;
+      case Op::kBinSelect:
+        bin_select_ = (uint64_t(operation.a) << 32) | operation.b;
+        break;
+      case Op::kEventInitiator:
+        WriteRegister(XE_GPU_REG_VGT_EVENT_INITIATOR, operation.a);
+        break;
+      case Op::kVizQuery:
+        ExecuteVizQuery(operation.a);
+        break;
+      case Op::kPacket: {
+        // Like the parse's reader: past the header, the write offset wrapped to 0 (a reader
+        // at its start would read as empty).
+        const size_t size_bytes = size_t(operation.c) * sizeof(uint32_t);
+        memory::RingBuffer reader(
+            reinterpret_cast<uint8_t*>(const_cast<uint32_t*>(words + operation.b)), size_bytes);
+        reader.set_write_offset(size_bytes);
+        reader.set_read_offset(sizeof(uint32_t));
+        if (!ExecutePacketType3(&reader, operation.a)) {
+          // The parse stops the buffer there.
+          REXGPU_ERROR("**** INDIRECT RINGBUFFER: Failed to execute packet.");
+          assert_always();
+          --indirect_buffer_replay_depth_;
+          buffer.replaying = false;
+          return;
+        }
+      } break;
+    }
+  }
+  --indirect_buffer_replay_depth_;
+  buffer.replaying = false;
+}
