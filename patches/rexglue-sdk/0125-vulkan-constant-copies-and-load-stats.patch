+// Copies the float constants a shader uses (bitmap of 4 x 64 constants of 4 registers) into a
+// constant buffer, a run of consecutive constants per memcpy instead of one at a time (as 0101 does
+// for D3D12).
+uint8_t* CopyUsedFloatConstants(uint8_t* dest, const uint32_t* first_register, const uint64_t* bitmap) {
+  for (uint32_t i = 0; i < 4; ++i) {
+    uint64_t bits = bitmap[i];
+    while (bits) {
+      uint32_t first = uint32_t(std::countr_zero(bits));
+      uint32_t run = uint32_t(std::countr_one(bits >> first));
+      std::memcpy(dest, first_register + (i << 8) + (first << 2), run * 4 * sizeof(float));
+      dest += run * 4 * sizeof(float);
+      bits = first + run >= 64 ? 0 : bits & (~uint64_t(0) << (first + run));
+    }
+  }
+  return dest;
+}
+
+// CPU time the whole process has run, in nanoseconds.
+uint64_t ProcessCpuTimeNs() {
+#if REX_PLATFORM_WIN32
+  FILETIME creation, exit, kernel, user;
+  if (!GetProcessTimes(GetCurrentProcess(), &creation, &exit, &kernel, &user)) {
+    return 0;
+  }
+  auto ticks = [](const FILETIME& time) {
+    return (uint64_t(time.dwHighDateTime) << 32) | time.dwLowDateTime;
+  };
+  return (ticks(kernel) + ticks(user)) * 100;
+#else
+  timespec time;
+  if (clock_gettime(CLOCK_PROCESS_CPUTIME_ID, &time)) {
+    return 0;
+  }
+  return uint64_t(time.tv_sec) * 1000000000 + uint64_t(time.tv_nsec);
+#endif
+}
