+void VulkanCommandProcessor::ReadCompletedGpuTimes() {
+  if (gpu_time_pending_.empty()) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  while (!gpu_time_pending_.empty() && gpu_time_pending_.front().first <= submission_completed_) {
+    uint64_t timestamps[2];
+    if (dfn.vkGetQueryPoolResults(vulkan_device->device(), gpu_time_query_pool_,
+                                  gpu_time_pending_.front().second * 2, 2, sizeof(timestamps),
+                                  timestamps, sizeof(uint64_t), VK_QUERY_RESULT_64_BIT) ==
+            VK_SUCCESS &&
+        timestamps[1] >= timestamps[0]) {
+      gpu_time_ticks_ += timestamps[1] - timestamps[0];
+    }
+    gpu_time_pending_.pop_front();
+  }
+}
