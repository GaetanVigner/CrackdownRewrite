diff --git a/src/graphics/vulkan/texture_cache.cpp b/src/graphics/vulkan/texture_cache.cpp
--- a/src/graphics/vulkan/texture_cache.cpp
+++ b/src/graphics/vulkan/texture_cache.cpp
@@ -673,6 +673,36 @@ VkImageView VulkanTextureCache::GetActiveBindingOrNullImageView(uint32_t fetch_c
 
 VulkanTextureCache::SamplerParameters VulkanTextureCache::GetSamplerParameters(
     const VulkanShader::SamplerBinding& binding) const {
+  xenos::xe_gpu_texture_fetch_t fetch = register_file().GetTextureFetch(binding.fetch_constant);
+  uint32_t fetch_dwords[6];
+  static_assert(sizeof(fetch) == sizeof(fetch_dwords));
+  std::memcpy(fetch_dwords, &fetch, sizeof(fetch_dwords));
+  const uint32_t binding_filters = uint32_t(binding.mag_filter) | (uint32_t(binding.min_filter) << 8) |
+                                   (uint32_t(binding.mip_filter) << 16) |
+                                   (uint32_t(binding.aniso_filter) << 24);
+  const int32_t anisotropic_override = REXCVAR_GET(anisotropic_override);
+  uint32_t hash = binding_filters * 0x9E3779B1u;
+  for (uint32_t dword : fetch_dwords) {
+    hash = (hash ^ dword) * 0x9E3779B1u;
+  }
+  SamplerParametersCacheEntry& entry =
+      sampler_parameters_cache_[(hash >> 24) & (kSamplerParametersCacheSize - 1)];
+  if (entry.valid && entry.binding_filters == binding_filters &&
+      entry.anisotropic_override == anisotropic_override &&
+      !std::memcmp(entry.fetch, fetch_dwords, sizeof(fetch_dwords))) {
+    return entry.parameters;
+  }
+  SamplerParameters parameters = GetSamplerParametersUncached(binding);
+  std::memcpy(entry.fetch, fetch_dwords, sizeof(fetch_dwords));
+  entry.binding_filters = binding_filters;
+  entry.anisotropic_override = anisotropic_override;
+  entry.parameters = parameters;
+  entry.valid = true;
+  return parameters;
+}
