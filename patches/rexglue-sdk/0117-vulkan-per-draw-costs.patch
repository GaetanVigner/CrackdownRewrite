Cheaper Vulkan draws, found with 0116's section timers (city spot, ~4,500 draws a frame):
- IssueDraw asked IsReadbackMemexportEnabled on every draw, which looks the legacy readback cvar up in the cvar
  registry by name (a lock and a string hash, ~130 ns); it is now only asked for draws that export, like D3D12.
- VulkanTextureCache::GetSamplerParameters parses the fetch constant (clamp, filters, the texture's host format for
  filterability, mip range) for each of a draw's samplers (~104 ns a draw against ~54 on D3D12 with 0111's caches). Its
  result depends only on the six fetch constant dwords, the binding's filter overrides and anisotropic_override, so the
  last results are kept in a 256-entry direct-mapped table keyed by them.

diff --git a/include/rex/graphics/vulkan/texture_cache.h b/include/rex/graphics/vulkan/texture_cache.h
--- a/include/rex/graphics/vulkan/texture_cache.h
+++ b/include/rex/graphics/vulkan/texture_cache.h
@@ -393,6 +393,21 @@ class VulkanTextureCache final : public TextureCache {
 
   xenos::AnisoFilter max_anisotropy_;
 
+  // GetSamplerParameters derives the parameters from the six fetch constant dwords, the binding's
+  // filter overrides and anisotropic_override only, so the last results are kept in a direct-mapped
+  // table keyed by them (most draws repeat their samplers).
+  SamplerParameters GetSamplerParametersUncached(const VulkanShader::SamplerBinding& binding) const;
+  struct SamplerParametersCacheEntry {
+    uint32_t fetch[6];
+    uint32_t binding_filters;
+    int32_t anisotropic_override;
+    SamplerParameters parameters;
+    bool valid = false;
+  };
+  static constexpr uint32_t kSamplerParametersCacheSize = 256;
+  mutable std::array<SamplerParametersCacheEntry, kSamplerParametersCacheSize>
+      sampler_parameters_cache_;
+
   std::unordered_map<SamplerParameters, Sampler, SamplerParameters::Hasher> samplers_;
   std::pair<const SamplerParameters, Sampler>* sampler_used_first_ = nullptr;
   std::pair<const SamplerParameters, Sampler>* sampler_used_last_ = nullptr;
