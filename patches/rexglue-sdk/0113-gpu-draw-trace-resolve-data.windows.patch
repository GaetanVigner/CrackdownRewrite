+
+void CommandProcessor::DrawTraceResolveData(uint32_t address, const void* data, uint32_t length) {
+  DrawTrace& trace = g_draw_trace;
+  if (!trace.resolve_file) {
+    return;
+  }
+  std::FILE* file = trace.resolve_file;
+  WriteU32(file, trace.frame);
+  WriteU32(file, trace.sequence - 1);
+  WriteU32(file, address);
+  WriteU32(file, length);
+  WriteU32(file, register_file_->values[XE_GPU_REG_RB_COPY_DEST_INFO]);
+  WriteU32(file, register_file_->values[XE_GPU_REG_RB_COPY_DEST_PITCH]);
+  std::fwrite(data, 1, length, file);
+}
