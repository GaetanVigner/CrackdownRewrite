+void CommandProcessor::Any360CaptureKick(uint32_t read_index, uint32_t write_index) {
+  Any360Capture& capture = g_any360_capture;
+  if (!capture.pending_path.empty()) {
+    const std::string path = std::move(capture.pending_path);
+    capture.pending_path.clear();
+    const std::string info = "ReXGlue command processor (" + path + "), " + std::to_string(capture.frames_left) +
+                             " frame(s)";
+    if (capture.writer.Open(path, memory_->TranslatePhysical(0), 0x20000000u, register_file_->values,
+                            uint32_t(RegisterFile::kRegisterCount), info)) {
+      auto ucode = [](const Shader* shader) {
+        return shader ? std::vector<uint32_t>(shader->ucode_dwords(), shader->ucode_dwords() + shader->ucode_dword_count())
+                      : std::vector<uint32_t>();
+      };
+      capture.writer.Shaders(ucode(active_vertex_shader_), ucode(active_pixel_shader_));
+      // The gamma ramp the title wrote long before (not in the register file).
+      capture.writer.GammaRamp(reinterpret_cast<const uint32_t*>(gamma_ramp_256_entry_table()),
+                               reinterpret_cast<const uint32_t*>(gamma_ramp_pwl_rgb()));
+      REXGPU_INFO("Any360 capture: recording {} frame(s) to {}", capture.frames_left, path);
+    } else {
+      REXGPU_ERROR("Any360 capture: cannot open {}", path);
+    }
+  }
+  if (capture.writer.is_open()) {
+    capture.writer.Kick(primary_buffer_ptr_ & 0x1FFFFFFF, primary_buffer_size_ / 4, read_index, write_index);
+  }
+}
+
+void CommandProcessor::Any360CaptureSwap() {
+  Any360Capture& capture = g_any360_capture;
+  if (!capture.writer.is_open()) return;
+  // The presented frame, as the presenter holds it (RGBX rows at a stride), packed to RGBA.
+  rex::ui::Presenter* presenter = graphics_system_ ? graphics_system_->presenter() : nullptr;
+  rex::ui::RawImage image;
+  if (presenter && presenter->CaptureGuestOutput(image) && image.width && image.height) {
+    std::vector<uint32_t> rgba(size_t(image.width) * image.height);
+    for (uint32_t y = 0; y < image.height; ++y) {
+      std::memcpy(rgba.data() + size_t(y) * image.width, image.data.data() + size_t(y) * image.stride,
+                  size_t(image.width) * 4);
+    }
+    for (uint32_t& pixel : rgba) pixel |= 0xFF000000u;
+    capture.writer.Frame(image.width, image.height, rgba.data());
+  } else {
+    REXGPU_WARN("Any360 capture: frame {} not read from the presenter", capture.frames);
+  }
+  ++capture.frames;
+  if (--capture.frames_left == 0) {
+    const uint64_t bytes = capture.writer.bytes_written();
+    capture.writer.Close();
+    REXGPU_INFO("Any360 capture: {} frame(s), {} MB written", capture.frames, bytes >> 20);
+  }
+}
