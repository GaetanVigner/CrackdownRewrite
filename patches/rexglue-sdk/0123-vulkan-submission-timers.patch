   uint64_t constants_sets_written_ = 0;
+  // gpu_frame_stats: DrawTicks spent in EndSubmission, in its command buffer replay and submission
+  // (synchronous path), and in IssueSwap (which includes the frame's last EndSubmission).
+  uint64_t end_submission_ticks_ = 0;
+  uint64_t replay_ticks_ = 0;
+  uint64_t swap_ticks_ = 0;
+  struct ScopedTicks {
+    uint64_t* total;
+    uint64_t start;
+    explicit ScopedTicks(uint64_t* total_in, bool enabled, uint64_t now)
+        : total(enabled ? total_in : nullptr), start(now) {}
+    ~ScopedTicks();
+  };
   uint64_t texture_sets_written_ = 0;
   bool draw_timing_ = false;
   uint64_t draw_mark_ = 0;
