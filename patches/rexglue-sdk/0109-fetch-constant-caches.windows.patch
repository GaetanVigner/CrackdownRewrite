 D3D12TextureCache::SamplerParameters D3D12TextureCache::GetSamplerParameters(
     const D3D12Shader::SamplerBinding& binding) const {
+  if (!REXCVAR_GET(gpu_fetch_constant_caches)) {
+    return ComputeSamplerParameters(binding);
+  }
+  if (!sampler_cache_) {
+    sampler_cache_ = std::make_unique<SamplerCacheEntry[]>(size_t(1) << kSamplerCacheSizeLog2);
+  }
+  const uint32_t* fetch_dwords =
+      &register_file().values[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 + binding.fetch_constant * 6];
+  const uint32_t binding_filters = uint32_t(binding.mag_filter) |
+                                   (uint32_t(binding.min_filter) << 8) |
+                                   (uint32_t(binding.mip_filter) << 16) |
+                                   (uint32_t(binding.aniso_filter) << 24);
+  const int32_t anisotropic_override = REXCVAR_GET(anisotropic_override);
+  uint64_t hash = binding_filters;
+  for (uint32_t i = 0; i < 6; ++i) {
+    hash = (hash ^ fetch_dwords[i]) * UINT64_C(0x9E3779B97F4A7C15);
+  }
+  SamplerCacheEntry& entry = sampler_cache_[hash >> (64 - kSamplerCacheSizeLog2)];
+  if (entry.valid && entry.binding_filters == binding_filters &&
+      entry.anisotropic_override == anisotropic_override &&
+      !std::memcmp(entry.fetch, fetch_dwords, sizeof(entry.fetch))) {
+    ++g_gpu_frame_stats.fetch_cache_sampler_hits;
+    return entry.parameters;
+  }
+  ++g_gpu_frame_stats.fetch_cache_sampler_misses;
+  entry.parameters = ComputeSamplerParameters(binding);
+  std::memcpy(entry.fetch, fetch_dwords, sizeof(entry.fetch));
+  entry.binding_filters = binding_filters;
+  entry.anisotropic_override = anisotropic_override;
+  entry.valid = true;
+  return entry.parameters;
+}
