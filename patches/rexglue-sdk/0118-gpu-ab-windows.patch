In-run A/B measurements on Vulkan: with gpu_frame_stats on, gpu_ab_cvar names a hot-reloadable cvar that is switched
to the next of gpu_ab_values (comma-separated) at the end of every 10 s stats window, and each window's CPU and
IssueDraw log lines name the value in force, so A and B are measured in the same scene within one run instead of
across runs. The CPU line also gives the window's FPS. vulkan_sampler_parameters_cache (on, hot reload) switches
0117's sampler parameter table, so its effect can be measured that way.

diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -90,6 +90,15 @@ REXCVAR_DEFINE_UINT32(vulkan_async_submission_draws, 2000, "GPU/Vulkan",
 
 REXCVAR_DECLARE(bool, gpu_frame_stats);
 
+REXCVAR_DEFINE_STRING(gpu_ab_cvar, "", "GPU",
+                      "With gpu_frame_stats on Vulkan: a hot-reloadable cvar switched to the next of "
+                      "gpu_ab_values at the end of every 10 s stats window, so one run measures A and "
+                      "B in the same scene (each window's log line names the value)")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+REXCVAR_DEFINE_STRING(gpu_ab_values, "", "GPU",
+                      "Comma-separated values gpu_ab_cvar takes in turn (e.g. true,false)")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
 namespace rex::graphics::vulkan {
 
 namespace {
@@ -5431,10 +5440,15 @@ void VulkanCommandProcessor::LogCpuFrameStats() {
   }
   const double frames = double(cpu_stats_frames_ - 1);
   const double per_frame_ms = 1.0e-6 / frames;
+  const std::string ab_cvar = REXCVAR_GET(gpu_ab_cvar);
+  const std::string ab_tag =
+      ab_cvar.empty() ? std::string()
+                      : fmt::format(" [A/B {}={}]", ab_cvar, rex::cvar::GetFlagByName(ab_cvar));
   REXGPU_INFO(
-      "Vulkan CPU per frame over {:.1f} s: frame {:.2f} ms, command processor thread {:.2f} ms, "
-      "submission thread {:.2f} ms (async submission {})",
-      seconds, seconds * 1000.0 / frames, double(processor_ns - cpu_stats_processor_ns_) * per_frame_ms,
+      "Vulkan CPU per frame over {:.1f} s{}: {:.1f} FPS, frame {:.2f} ms, command processor thread "
+      "{:.2f} ms, submission thread {:.2f} ms (async submission {})",
+      seconds, ab_tag, frames / seconds, seconds * 1000.0 / frames,
+      double(processor_ns - cpu_stats_processor_ns_) * per_frame_ms,
       double(submission_ns - cpu_stats_submission_ns_) * per_frame_ms,
       async_submission_enabled_ ? "on" : "off");
   if (draw_timed_count_ && ticks > cpu_stats_start_ticks_) {
@@ -5453,11 +5467,34 @@ void VulkanCommandProcessor::LogCpuFrameStats() {
                               draws > 0.0 ? section_ms[i] * 1.0e6 / draws : 0.0);
     }
     REXGPU_INFO(
-        "Vulkan IssueDraw per frame: {:.0f} draws, {:.2f} ms ({:.0f} ns a draw), {:.0f} render pass "
+        "Vulkan IssueDraw per frame{}: {:.0f} draws, {:.2f} ms ({:.0f} ns a draw), {:.0f} render pass "
         "entries; ns a draw: {}",
-        draws, total_ms, draws > 0.0 ? total_ms * 1.0e6 / draws : 0.0,
+        ab_tag, draws, total_ms, draws > 0.0 ? total_ms * 1.0e6 / draws : 0.0,
         double(render_passes_begun_) / frames, sections);
   }
+  if (!ab_cvar.empty()) {
+    // Next value after the current one (the first when the current one is not listed).
+    std::vector<std::string> values;
+    std::string_view list = REXCVAR_GET(gpu_ab_values);
+    while (!list.empty()) {
+      size_t comma = list.find(',');
+      values.emplace_back(list.substr(0, comma));
+      list = comma == std::string_view::npos ? std::string_view() : list.substr(comma + 1);
+    }
+    if (!values.empty()) {
+      const std::string current = rex::cvar::GetFlagByName(ab_cvar);
+      size_t next = 0;
+      for (size_t i = 0; i < values.size(); ++i) {
+        if (values[i] == current) {
+          next = (i + 1) % values.size();
+          break;
+        }
+      }
+      if (!rex::cvar::SetFlagByName(ab_cvar, values[next])) {
+        REXGPU_WARN("gpu_ab_cvar: cannot set {} to {}", ab_cvar, values[next]);
+      }
+    }
+  }
   restart_window();
 }
 
