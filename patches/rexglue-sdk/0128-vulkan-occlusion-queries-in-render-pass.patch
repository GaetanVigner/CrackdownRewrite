+void VulkanCommandProcessor::ReserveQueryResets(uint32_t minimum, bool may_wait) {
+  if (in_render_pass_ || !submission_open_ || occlusion_query_pool_ == VK_NULL_HANDLE ||
+      query_reset_end_ - query_reset_next_ >= minimum) {
+    return;
+  }
+  constexpr uint32_t kBlock = 64;
+  if (occlusion_query_cursor_ + kBlock > kMaxOcclusionQueries) {
+    if (!may_wait) {
+      return;  // a segment without an index is skipped; the guest's next begin wraps around
+    }
+    // Results still in flight must not be overwritten by the reused indices.
+    CompleteOcclusionQueries(true);
+    occlusion_query_cursor_ = 0;
+    if (!BeginSubmission(true) || in_render_pass_) {
+      return;
+    }
+  }
+  query_reset_next_ = occlusion_query_cursor_;
+  query_reset_end_ = occlusion_query_cursor_ + kBlock;
+  occlusion_query_cursor_ += kBlock;
+  deferred_command_buffer_.CmdVkResetQueryPool(occlusion_query_pool_, query_reset_next_, kBlock);
+}
+
+void VulkanCommandProcessor::BeginQuerySegment() {
+  // Only inside a guest render pass, with an index reset ahead (OcclusionQueryBeforeGuestRenderPassBegin).
+  if (query_reset_next_ == query_reset_end_) {
+    return;
+  }
+  uint32_t index = query_reset_next_++;
+  deferred_command_buffer_.CmdVkBeginQuery(occlusion_query_pool_, index, 0);
+  active_occlusion_query_.host_index = index;
+  active_occlusion_query_.segment_open = true;
+}
+
+void VulkanCommandProcessor::EndQuerySegment() {
+  deferred_command_buffer_.CmdVkEndQuery(occlusion_query_pool_, active_occlusion_query_.host_index);
+  active_occlusion_query_.segments.push_back(active_occlusion_query_.host_index);
+  query_copies_pending_.push_back(active_occlusion_query_.host_index);
+  active_occlusion_query_.segment_open = false;
+}
+
+void VulkanCommandProcessor::OcclusionQueryBeforeGuestRenderPassBegin() {
+  if (active_occlusion_query_.segmented || REXCVAR_GET(vulkan_occlusion_queries_in_render_pass)) {
+    ReserveQueryResets(16, false);
+  }
+}
+
+void VulkanCommandProcessor::OcclusionQueryAfterGuestRenderPassBegin() {
+  if (active_occlusion_query_.valid && active_occlusion_query_.segmented &&
+      !active_occlusion_query_.segment_open) {
+    BeginQuerySegment();
+  }
+}
+
+void VulkanCommandProcessor::OcclusionQueryBeforeRenderPassEnd() {
+  if (active_occlusion_query_.valid && active_occlusion_query_.segmented &&
+      active_occlusion_query_.segment_open) {
+    EndQuerySegment();
+  }
+}
+
+void VulkanCommandProcessor::FlushQueryCopies() {
+  // Outside any render pass (copies are not allowed in one); the readback barrier is submitted with the others.
+  for (uint32_t index : query_copies_pending_) {
+    deferred_command_buffer_.CmdVkCopyQueryPoolResults(
+        occlusion_query_pool_, index, 1, occlusion_query_readback_buffer_, sizeof(uint64_t) * index,
+        sizeof(uint64_t), VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WAIT_BIT);
+    PushBufferMemoryBarrier(occlusion_query_readback_buffer_, sizeof(uint64_t) * index, sizeof(uint64_t),
+                            VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT,
+                            VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_HOST_READ_BIT);
+  }
+  query_copies_pending_.clear();
+}
