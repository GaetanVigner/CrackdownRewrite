+void VulkanCommandProcessor::GpuCategoryMark(GpuCategory category) {
+  // Queries are reset just before they are written, which a render pass does not allow; a marker that would
+  // overwrite one not read yet is dropped (its interval joins the previous one's category).
+  if (gpu_category_query_pool_ == VK_NULL_HANDLE || !submission_open_ || in_render_pass_ ||
+      !REXCVAR_GET(gpu_frame_stats) || gpu_category_pending_.size() >= kGpuCategoryQueries - 1) {
+    return;
+  }
+  uint32_t query = gpu_category_next_query_;
+  gpu_category_next_query_ = (gpu_category_next_query_ + 1) % kGpuCategoryQueries;
+  deferred_command_buffer_.CmdVkResetQueryPool(gpu_category_query_pool_, query, 1);
+  deferred_command_buffer_.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+                                               gpu_category_query_pool_, query);
+  gpu_category_pending_.push_back({GetCurrentSubmission(), query, category});
+}
+
 void VulkanCommandProcessor::ReadCompletedGpuTimes() {
+  if (!gpu_category_pending_.empty()) {
+    const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+    const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+    while (!gpu_category_pending_.empty() &&
+           gpu_category_pending_.front().submission <= submission_completed_) {
+      const uint64_t submission = gpu_category_pending_.front().submission;
+      uint64_t previous_time = 0;
+      GpuCategory previous_category = kGpuCategoryEnd;
+      while (!gpu_category_pending_.empty() &&
+             gpu_category_pending_.front().submission == submission) {
+        const GpuCategoryMarker marker = gpu_category_pending_.front();
+        gpu_category_pending_.pop_front();
+        uint64_t time;
+        if (dfn.vkGetQueryPoolResults(vulkan_device->device(), gpu_category_query_pool_, marker.query, 1,
+                                      sizeof(time), &time, sizeof(time),
+                                      VK_QUERY_RESULT_64_BIT) != VK_SUCCESS) {
+          previous_category = kGpuCategoryEnd;
+          continue;
+        }
+        if (previous_category < kGpuCategoryCount && time >= previous_time) {
+          gpu_category_ticks_[previous_category] += time - previous_time;
+        }
+        previous_time = time;
+        previous_category = marker.category;
+      }
+    }
+  }
   if (gpu_time_pending_.empty()) {
     return;
   }
