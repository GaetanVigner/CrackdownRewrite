+  // (with fixed ranges, see kConstantBufferDynamicRanges in the .cpp), the offsets are given when
+  // it is bound, so one set serves every draw whose constants are in the same upload pages.
+  struct ConstantsBuffersKey {
+    VkBuffer buffers[SpirvShaderTranslator::kConstantBufferCount];
+    bool operator==(const ConstantsBuffersKey& other) const {
